<?xml version="1.0" encoding="utf-8"?>
<!-- Only the small Pro/free-trial store is backed up, so reinstalling cannot reset the free High Quality tries. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/auramic_pro.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/auramic_pro.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
