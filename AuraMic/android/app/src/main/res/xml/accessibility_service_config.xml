<?xml version="1.0" encoding="utf-8"?>
<!--
  AuraMic accessibility service. Deliberately narrow:
   - only the supported chat apps (WhatsApp, WhatsApp Business) are delivered (packageNames),
   - it needs the window content to find the chat row and the "Send" button,
   - it looks only for the position of WhatsApp's own voice button (to place the AuraMic mic on it) and acts only
     when the user has just recorded a voice note; message content is never read,
   - typeViewClicked: only for the minute after an automatic chat search failed, to note which row of WhatsApp's chat
     list the user tapped (its name stays on the phone, so the next note can find that chat by itself).
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagIncludeNotImportantViews|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="true"
    android:description="@string/a11y_description"
    android:notificationTimeout="100"
    android:packageNames="com.whatsapp,com.whatsapp.w4b" />
